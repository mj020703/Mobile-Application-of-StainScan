# StainScan Environment Configuration
# Copy this file to .env and configure your MongoDB Atlas credentials:

# MongoDB Atlas Cloud Connection String
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority&appName=<app-name>
MONGO_URI=

# Database Name (default: stainscan_db)
MONGO_DB_NAME=stainscan_db

# Local Server Port (default: 5000)
PORT=5000
